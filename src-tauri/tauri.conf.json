{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LevelUpAgent",
  "version": "1.2.72",
  "identifier": "com.levelup.agent",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "LevelUpAgent",
        "width": 1440,
        "height": 920,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost asset: http://asset.localhost blob:; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "TippingGame",
    "createUpdaterArtifacts": false,
    "targets": "all",
    "resources": {
      "resources/skills/": "resources/skills/",
      "../themes/": "themes/",
      "../modules/model_workbench/launcher.py": "modules/model_workbench/launcher.py",
      "../modules/model_workbench/resources.json": "modules/model_workbench/resources.json",
      "../modules/model_workbench/app/__init__.py": "modules/model_workbench/app/__init__.py",
      "../modules/model_workbench/app/worker.py": "modules/model_workbench/app/worker.py",
      "../modules/model_workbench/app/image_preparation.py": "modules/model_workbench/app/image_preparation.py",
      "../modules/model_workbench/app/triposg_worker.py": "modules/model_workbench/app/triposg_worker.py",
      "../modules/model_workbench/app/texture_worker.py": "modules/model_workbench/app/texture_worker.py",
      "../modules/model_workbench/app/mesh_geometry.py": "modules/model_workbench/app/mesh_geometry.py",
      "../modules/model_workbench/app/rig_worker.py": "modules/model_workbench/app/rig_worker.py"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "languages": ["English", "SimpChinese", "TradChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
